{
  "name": "ebb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Ebb: a small tidal island. The sea leaves and the rest of the world appears.",
  "scripts": {
    "dev": "vite --port 5241 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5240 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "tour": "node scripts/tour.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
